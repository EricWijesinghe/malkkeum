# Machine-specific tool locations. Copy to scripts/local.env (gitignored) and edit.
# Read by scripts/env.sh (bash) and scripts/local-env.ps1 (PowerShell). One KEY=VALUE per line,
# no spaces around "="; quote values that contain spaces. Variables already set in the
# environment win over this file.

# Root folder holding flutter/, cargo-home/, pub-cache/, gradle/, npm-cache/, tmp/, ms-playwright/.
# Leave unset to use the tools and caches already on PATH.
# DAHAE_TOOLS=/opt/dahae-tools

# JDK for Android builds (keytool, jarsigner, Gradle).
# JAVA_HOME="/usr/lib/jvm/java-21-openjdk"

# PostgreSQL 17 binaries and data directory for the local dev database (port 5433).
# PG_BIN=/usr/lib/postgresql/17/bin
# PGDATA=/var/lib/postgresql/17/dahae

# Playwright package used by scripts/store/frame.js and scripts/perf/measure_site.js
# (default: the "playwright" package resolvable from the repo).
# SHOT_PLAYWRIGHT=/opt/shot/node_modules/playwright

# Release build output (signing keys, logs, staged kits) for scripts/release/build-all.ps1.
# Default: <repo>/targets. Keep the same folder between runs so the upload key is reused.
# DAHAE_TARGETS=/srv/dahae-targets

# Working folder for scripts/e2e/wsl-e2e.ps1 (rootfs download, image tar, logs).
# DAHAE_E2E_ROOT=/srv/dahae-e2e
