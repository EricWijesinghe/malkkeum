"svcDesc_studio": {
"ko": "방 1개, 화장실 1개인 10평 이하 원룸을 2시간 동안 꼼꼼히 청소해요.",
"en": "A 2-hour clean of a studio up to 10 pyeong: one room and one bathroom."
},
"svcDesc_kitchen": {
"ko": "싱크대, 가스레인지, 후드 겉면, 상판을 중심으로 주방을 집중 청소해요.",
"en": "Focused kitchen clean: sink, stove, hood exterior and counters."
},
"svcDesc_bathroom": {
"ko": "선반, 수전, 세면대와 변기의 안팎을 청소하고 바닥 물기까지 정리해요.",
"en": "Shelves, taps, basin and toilet inside and out, finished with a dry floor."
},
"svcDesc_mattress": {
"ko": "전문 장비로 먼지, 진드기, 얼룩을 흡입하고 스팀으로 살균 세척해요.",
"en": "Pro equipment extracts dust, mites and stains, then steam-sanitises."
},
"svcDesc_aircon": {
"ko": "분해 후 열교환기, 송풍팬, 필터를 고압 세척하고 살균으로 마무리해요.",
"en": "Disassembled, then coil, fan and filter pressure-washed and sanitised."
},
"svcDesc_sofa": {
"ko": "소재에 맞는 세제로 오염을 분해하고 습식 추출 방식으로 세척해요.",
"en": "Fabric-matched cleaner breaks down dirt, then wet extraction lifts it out."
},
"svcDesc_move_out": {
"ko": "이사 나가기 전, 짐을 뺀 집을 전문 청소팀이 장비를 가지고 방문해 청소해요.",
"en": "Before you move out, a pro team brings equipment and cleans the empty home."
},
"svcDesc_move_in": {
"ko": "새 집에 들어가기 전, 전문 청소팀이 장비를 가지고 방문해 실내를 청소해요.",
"en": "Before you move in, a pro team brings equipment and cleans the new home."
},
"svcNotes_bathroom": {
"ko": "배수구·변기 막힘이 있으면 서비스가 제한될 수 있어요\n특수 약품이 필요한 청소, 천장·환풍기 청소는 제공하지 않아요\n오래된 곰팡이·찌든 때는 완전히 제거되지 않을 수 있어요",
"en": "Blocked drains or toilets may limit the service\nNo special-chemical, ceiling or vent cleaning\nOld mould and set-in grime may not fully come off"
},
"svcNotes_mattress": {
"ko": "싱글부터 킹 사이즈까지 같은 금액이에요\n세척 후 완전 건조까지 4~6시간 걸려요\n스프링 손상, 꺼짐 등 구조적인 문제는 개선되지 않아요",
"en": "Same price from single to king\nFully dry in 4–6 hours\nSpring damage or sagging can't be fixed"
},
"svcNotes_aircon": {
"ko": "제조 10년 이상 제품은 분해 세척이 어려울 수 있어요\n실외기 청소는 포함되지 않아요\n세척 전후 정상 작동 여부를 함께 확인해요",
"en": "Units over 10 years old may not be safe to disassemble\nOutdoor unit not included\nWe check it works before and after"
},
"svcNotes_sofa": {
"ko": "가죽 소파는 클리닝과 보습 코팅으로 진행돼요\n오래된 얼룩·이염은 완전히 제거되지 않을 수 있어요\n완전 건조까지 4~6시간 걸려요",
"en": "Leather sofas get cleaning plus conditioning\nOld stains or dye transfer may not fully lift\nFully dry in 4–6 hours"
},
