# One domain for everything, HTTPS certificates issued and renewed automatically:
#   https://DOMAIN/          website
#   https://DOMAIN/app/      customer web app (PWA; every /app/* deep link serves index.html)
#   https://DOMAIN/admin/    operations console (setup wizard on first visit)
#   https://DOMAIN/v1, /health   API (uploads: /v1/files, signed URLs only)
#   https://DOMAIN/.well-known/assetlinks.json, apple-app-site-association   App Links, served by the API from env
#   https://DOMAIN/auth/naver/callback   Naver login: the app takes this URL (App Link); the page is only the browser fallback
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	# Empty = automatic public HTTPS; TLS_MODE=internal = Caddy CA (installer tests only).
	tls {$TLS_MODE}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Site-wide CSP. Every API, websocket and PWA call is same-origin ('self' also covers ws/wss).
		# script-src: 'unsafe-inline' for the website theme snippet, the PortOne page and Flutter's
		#   bootstrap (no hashes: Flutter rewrites its bootstrap per build). cdn.portone.io = PortOne V2 browser SDK
		#   (website/pay/index.html). No 'unsafe-eval': the web build is compiled with --wasm (skwasm).
		# wasm-unsafe-eval: WebAssembly compile for skwasm/CanvasKit (self-hosted, --no-web-resources-cdn).
		# style-src / font-src: cdn.jsdelivr.net serves the website's Pretendard CSS and font files. No Google Fonts.
		# connect-src: *.portone.io = PortOne API (api.portone.io) and SDK calls. Social sign-in (Kakao, Naver,
		#   Google, Apple) runs in the native apps only; the web build offers no social SDK, so no hosts here.
		# frame-src / form-action: PG payment windows (card, KakaoPay, NaverPay...) are hosted by many PGs whose
		#   hosts PortOne does not publish as a fixed list; keep https: or checkout breaks.
		# frame-ancestors none: nothing may embed us.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.portone.io; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' data: https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; connect-src 'self' https://*.portone.io; frame-src 'self' https:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https:; frame-ancestors 'none'"
		-Server
	}

	@api path /v1/* /health /.well-known/assetlinks.json /.well-known/apple-app-site-association
	handle @api {
		reverse_proxy api:8080
	}

	redir /admin /admin/
	handle_path /admin/* {
		root * /srv/console
		try_files {path} /index.html
		file_server
	}

	# Entry points and the service worker must revalidate; the rest is cached for a day.
	# Named matchers must be declared at site level (not inside handle_path); their paths are
	# the ones seen after handle_path strips /app.
	@app_entry path / /index.html /flutter_bootstrap.js /flutter.js /flutter_service_worker.js /version.json /manifest.json
	@app_other not path / /index.html /flutter_bootstrap.js /flutter.js /flutter_service_worker.js /version.json /manifest.json
	redir /app /app/
	handle_path /app/* {
		root * /srv/app
		try_files {path} /index.html
		header @app_entry Cache-Control "no-cache"
		header @app_other Cache-Control "public, max-age=86400"
		file_server
	}

	handle {
		root * /srv/website
		try_files {path} {path}.html {path}/index.html /index.html
		file_server
	}
}
