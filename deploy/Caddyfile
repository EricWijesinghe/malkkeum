# One domain for everything, HTTPS certificates issued and renewed automatically:
#   https://DOMAIN/          website
#   https://DOMAIN/app/      customer web app (PWA; every /app/* deep link serves index.html)
#   https://DOMAIN/admin/    operations console (setup wizard on first visit)
#   https://DOMAIN/v1, /health   API (uploads: /v1/files, signed URLs only)
#   https://DOMAIN/.well-known/assetlinks.json, apple-app-site-association   App Links, served by the API from env
#   https://www.DOMAIN/*     permanent redirect to https://DOMAIN/* (needs a www DNS record; harmless without one)
#   https://DOMAIN/auth/naver/callback   Naver login: the app takes this URL (App Link); the page is only the browser fallback
{
	# Quoted: an empty ACME_EMAIL (the installer allows it) is then one empty argument, not a parse error.
	email "{$ACME_EMAIL}"
}

# TLS_MODE picks one of these (`import tls-{$TLS_MODE}`): empty = automatic public HTTPS, internal = Caddy's
# own CA (installer tests only). A bare `tls {$TLS_MODE}` fails to parse when TLS_MODE is empty.
(tls-) {
}
(tls-internal) {
	tls internal
}

{$DOMAIN} {
	# TLS_MODE: see the tls- snippets above.
	import tls-{$TLS_MODE}
	encode zstd gzip

	# JSON access log in the caddylogs volume: 10 MB per file, 14 files kept. Query strings carry secrets (websocket
	# ticket, signed upload links, OAuth code and state), so those values are replaced before anything is written.
	# shortcut: no edge rate limit on /v1/auth/*, the stock caddy image has no rate_limit module; add one (custom
	#   image via xcaddy with mholt/caddy-ratelimit) or keep the app-level buckets (ratelimit.rs), when the edge needs it.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 14
		}
		format filter {
			wrap json
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>uri query {
					replace ticket REDACTED
					replace token REDACTED
					replace sig REDACTED
					replace code REDACTED
					replace state REDACTED
				}
			}
		}
	}

	# Deferred (it deletes a field), so these are set when the response is written, over anything upstream sent.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# No camera, microphone or USB for any page; location only for our own pages (address search).
		Permissions-Policy "camera=(), microphone=(), usb=(), geolocation=(self), browsing-topics=()"
		# Our pages keep their opener links to the PG payment popups they open, nothing else does.
		Cross-Origin-Opener-Policy same-origin-allow-popups
		-Server
	}

	# Two CSPs, chosen by path (the matchers are exact opposites, so exactly one applies).
	# Apps, payment pages and API-rendered pages get the policy below; the static website gets the strict
	# one after it.
	@app_csp path /v1/* /health /.well-known/* /c/* /sitemap.xml /robots.txt /notices.xml /webfonts/* /admin /admin/* /app /app/* /pay /pay/*
	@site_csp not path /v1/* /health /.well-known/* /c/* /sitemap.xml /robots.txt /notices.xml /webfonts/* /admin /admin/* /app /app/* /pay /pay/*
	# Every API, websocket and PWA call is same-origin ('self' also covers ws/wss).
	# script-src: 'unsafe-inline' for the PortOne pages (website/pay/) and Flutter's
	#   bootstrap (no hashes: Flutter rewrites its bootstrap per build). cdn.portone.io = PortOne V2 browser SDK
	#   (website/pay/index.html). No 'unsafe-eval': both web builds are compiled with --wasm (skwasm).
	# wasm-unsafe-eval: WebAssembly compile for skwasm/CanvasKit (self-hosted, --no-web-resources-cdn).
	# style-src / font-src: same origin only (the website self-hosts its Dahae Sans subset). No Google Fonts:
	#   the Flutter apps load their fallback fonts from /webfonts/ (same origin).
	# connect-src: *.portone.io = PortOne API (api.portone.io) and SDK calls. Social sign-in (Kakao, Naver,
	#   Google, Apple) runs in the native apps only; the web build offers no social SDK, so no hosts here.
	# frame-src / form-action: PG payment windows (card, KakaoPay, NaverPay...) are hosted by many PGs whose
	#   hosts PortOne does not publish as a fixed list; keep https: or checkout breaks.
	# frame-ancestors none: nothing may embed us.
	header @app_csp Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.portone.io; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.portone.io; frame-src 'self' https:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https:; frame-ancestors 'none'"
	# Static website: no inline script except the theme snippet in its pages' <head>, allowed by hash
	# (scripts/ci/check-native.py fails when a page's inline script has no hash here). No PG, no frames.
	header @site_csp Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-BAOxqSXTXY0xct7XpdRWh4Q+kVwbxikbI09LZ/Tqsqg=' 'sha256-UtC0U60paHl4CC9DOzN7OY+bZaNnUQ9p4kyLhFax6ts='; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self'; frame-src 'none'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

	# Probes and metrics are for the container runtime and the scraper on the server, never the internet.
	@internal path /ready /metrics
	respond @internal 404

	@api path /v1/* /health /.well-known/assetlinks.json /.well-known/apple-app-site-association
	handle @api {
		reverse_proxy api:8080
	}

	# Public SEO pages and feeds are rendered by the API from live data (crates/api/src/seo.rs).
	@seo path /c/* /sitemap.xml /robots.txt /notices.xml
	handle @seo {
		reverse_proxy api:8080
	}
	# Search Console / Search Advisor HTML-file verification (googleTOKEN.html, naverTOKEN.html).
	@verify path_regexp verify ^/(google|naver)[A-Za-z0-9_-]+\.html$
	handle @verify {
		reverse_proxy api:8080
	}

	# Live progress of a server job: the root agent writes /srv/ops-progress/<token>.json (state only) and removes it
	# 10 minutes after the job ends. The 128-bit token is the only key; no listing, never cached.
	@ops_progress path_regexp ops_progress ^/ops-progress/([0-9a-f]{32})$
	handle @ops_progress {
		rewrite * /{re.ops_progress.1}.json
		root * /srv/ops-progress
		header Cache-Control "no-store"
		file_server
	}

	# Fallback fonts for both Flutter apps (Roboto + Noto, mirrored at image build; deploy/flutter_bootstrap.js
	# points the engine here). Paths carry Google's version and hash, so they never change: cache forever.
	# No try_files: a missing font must be a 404, not index.html.
	handle_path /webfonts/* {
		root * /srv/webfonts
		header Cache-Control "public, max-age=31536000, immutable"
		header Content-Type font/woff2
		file_server
	}

	# Flutter web output has no content hashes in its file names (main.dart.js, main.dart.wasm, canvaskit/,
	# assets/), so a cached copy can be older than the bootstrap that loads it and break the app after a
	# deploy. Everything revalidates (ETag -> 304 when unchanged); only /webfonts/ above is immutable.
	redir /admin /admin/
	handle_path /admin/* {
		root * /srv/console
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}

	redir /app /app/
	handle_path /app/* {
		root * /srv/app
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}

	# Website file names carry no content hash, so assets are cached for an hour and pages revalidate.
	handle {
		root * /srv/website
		@site_assets path /assets/* /vendor/*
		@site_pages not path /assets/* /vendor/*
		header @site_assets Cache-Control "public, max-age=3600"
		header @site_pages Cache-Control "no-cache"
		# Seller details (전자상거래법 제10조) are written into the HTML here, on the server: {{httpInclude}}
		# fetches the API fragment /v1/public/seller-info (backend routes/seller.rs). Only text/html is templated,
		# and pay/ and auth/ stay as they are. A failing fragment fails the page, so keep the API up.
		@site_templated not path /assets/* /vendor/* /pay/* /auth/*
		templates @site_templated
		try_files {path} {path}.html {path}/index.html /index.html
		file_server
	}

	# API down or restarting (502/503 from the proxy): pages get a static maintenance page instead of a bare
	# error. API paths keep their own status, so the apps still get a JSON error they can read. /health stays a
	# plain error so health probes see the API as down, not a 200 page.
	handle_errors {
		@page_down expression {http.error.status} in [502, 503] && !{http.request.uri.path}.startsWith("/v1/") && !{http.request.uri.path}.startsWith("/health")
		handle @page_down {
			root * /srv/website
			rewrite * /maintenance.html
			header Cache-Control "no-store"
			file_server
		}
	}
}

# www -> apex. HSTS above covers subdomains, so without this site a visitor typing www gets a TLS error.
# Without a www DNS record Caddy only logs failed certificate attempts for www; the main site is unaffected.
www.{$DOMAIN} {
	import tls-{$TLS_MODE}
	header -Server
	redir https://{$DOMAIN}{uri} permanent
}
