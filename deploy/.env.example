# Developer reference only. Real installs use deploy/install.sh, which writes the server .env
# itself, and every integration key below can instead be entered in the console (Setup menu),
# where it is stored encrypted and overrides the variable here.
API_DOMAIN=api.example.com
CONSOLE_DOMAIN=console.example.com
DB_PASSWORD=          # openssl rand -hex 24   (Postgres superuser `app`: backups and admin only)
API_DB_PASSWORD=      # openssl rand -hex 24   (role `dahae_api` the API connects as: not a superuser)
JWT_SECRET=           # openssl rand -hex 32
DATA_KEY=             # openssl rand -hex 32   (encrypts bank accounts; back it up, never change it)
DEV_MODE=0            # NEVER 1 on a public server: dev mode returns login codes in the API response (anyone could sign in as anyone).
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=  # 12+ chars; change after first login

# Social sign-in: the API checks each token with the provider. Empty = provider refused in production (503).
KAKAO_APP_ID=          # Kakao REST app id; tokens issued to any other app are refused
GOOGLE_CLIENT_IDS=     # comma list: every OAuth client id that signs in (Android, iOS, web)
APPLE_CLIENT_IDS=      # comma list: iOS bundle id and the Services ID used on web
# Naver id + secret are entered in the console wizard (Naver card), not here.
# Naver App Link (/.well-known/assetlinks.json, apple-app-site-association). Empty = not served.
ANDROID_CERT_SHA256=         # comma list, AA:BB:..: Play App Signing certificate SHA-256 (Play Console > App integrity)
APPLE_TEAM_ID=               # 10-character Apple Team ID

# PortOne V2: one-off payments (checkout), virtual accounts, 본인인증 and webhooks.
# The app must pass checkout.id as the PortOne paymentId; webhooks and the recovery pass look payments up by it.
PORTONE_API_SECRET=          # PortOne console > API keys (sent as "Authorization: PortOne <secret>")
PORTONE_WEBHOOK_SECRET=      # whsec_... from the webhook settings (Standard Webhooks). Set it in production: with no secret the API refuses every webhook (unsigned events are accepted only in DEV_MODE).
PORTONE_STORE_ID=            # store-xxxx
PORTONE_CHANNEL_KEYS={"card":"channel-key-...","kakaopay":"channel-key-...","naverpay":"channel-key-...","tosspay":"channel-key-...","payco":"channel-key-...","samsungpay":"channel-key-...","applepay":"channel-key-...","transfer":"channel-key-...","virtual_account":"channel-key-...","phone":"channel-key-..."}
# Checkout recovery: every RECONCILE_INTERVAL_SECS the API asks PortOne about unfinished checkouts (2 min to 24 h old).
# Runs when DEV_MODE=1 or PORTONE_API_SECRET is set; otherwise it stays off.
RECONCILE_INTERVAL_SECS=60   # minimum 10

# Abuse limits. Rate limits are per client IP and per minute, kept in memory by each API process.
TRUSTED_PROXY=1              # 1 when the API sits behind Caddy (keys on the last X-Forwarded-For entry). 0 if clients reach the API directly.
RATE_LIMIT_AUTH_PER_MIN=20   # /v1/auth/* (sign-in and OTP requests)
RATE_LIMIT_UPLOAD_PER_MIN=30 # /v1/uploads
RATE_LIMIT_GENERAL_PER_MIN=300 # everything else
UPLOAD_DAILY_QUOTA=100       # uploads per user in any 24 h window; over it -> 429 upload_quota
MAX_OPEN_QUOTE_REQUESTS=3    # open quote requests per customer; over it -> 409 too_many_open_requests
MAX_CHAT_THREADS_PER_DAY=10  # new free-standing chat threads per customer per 24 h; over it -> 429 thread_quota

# Solapi: SMS (login codes, invites) and KakaoTalk AlimTalk (booking notices). Unset = no SMS outside DEV_MODE (503).
# Set SOLAPI_API_KEY and SOLAPI_API_SECRET together. Requests are signed per call (HMAC-SHA256, Solapi API v4).
SOLAPI_API_KEY=              # Solapi console > API keys
SOLAPI_API_SECRET=           # Solapi console > API keys (never commit)
SMS_SENDER=                  # registered sender number, digits only (e.g. 0212345678)
ALIMTALK_PF_ID=              # KakaoTalk channel (PF) id from Solapi
ALIMTALK_TEMPLATES={"booking.status":"KA01TP...","booking.completed":"KA01TP...","booking.reschedule_confirmed":"KA01TP..."}  # event kind -> approved template id; template variables: #{title}, #{body}

# Firebase Cloud Messaging (push). Service-account key file path, or the JSON inline. Unset = no push outside DEV_MODE.
FCM_SERVICE_ACCOUNT=         # /run/secrets/fcm-service-account.json or {"type":"service_account",...}
