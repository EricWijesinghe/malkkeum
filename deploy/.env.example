API_DOMAIN=api.example.com
CONSOLE_DOMAIN=console.example.com
DB_PASSWORD=          # openssl rand -hex 24
JWT_SECRET=           # openssl rand -hex 32
DATA_KEY=             # openssl rand -hex 32   (encrypts bank accounts; back it up, never change it)
DEV_MODE=0            # NEVER 1 on a public server: dev mode returns login codes in the API response (anyone could sign in as anyone).
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=  # 12+ chars; change after first login

# Social sign-in: the API checks each token with the provider. Empty = provider refused in production (503).
KAKAO_APP_ID=          # Kakao REST app id; tokens issued to any other app are refused
GOOGLE_CLIENT_IDS=     # comma list: every OAuth client id that signs in (Android, iOS, web)
APPLE_CLIENT_IDS=      # comma list: iOS bundle id and the Services ID used on web
# Naver needs no server-side id (see the shortcut note in providers/social.rs).

# PortOne V2: one-off payments (checkout), virtual accounts, 본인인증 and webhooks.
PORTONE_API_SECRET=          # PortOne console > API keys (sent as "Authorization: PortOne <secret>")
PORTONE_WEBHOOK_SECRET=      # whsec_... from the webhook settings (Standard Webhooks)
PORTONE_STORE_ID=            # store-xxxx
PORTONE_CHANNEL_KEYS={"card":"channel-key-...","kakaopay":"channel-key-...","naverpay":"channel-key-...","tosspay":"channel-key-...","payco":"channel-key-...","samsungpay":"channel-key-...","applepay":"channel-key-...","transfer":"channel-key-...","virtual_account":"channel-key-...","phone":"channel-key-..."}
